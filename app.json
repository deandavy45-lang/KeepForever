{
  "expo": {
    "name": "Keep Forever",
    "slug": "keep-forever",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.thekeepvault.keepforever",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Keep Forever uses your photo library so you can add photos to your family memories and keepsake books.",
        "NSCameraUsageDescription": "Keep Forever uses the camera so you can capture new memories.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "za.co.thekeepvault.keepforever",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Keep Forever uses your photo library so you can add photos to your family memories and keepsake books.",
          "cameraPermission": "Keep Forever uses the camera so you can capture new memories.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "keepforever",
    "experiments": {
      "typedRoutes": true
    }
  }
}